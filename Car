#include <iostream>
#include <string>
using namespace std;
class Car {
    string brand;
    int year;
public:
    Car(string b, int y) {
        brand = b;
        year = y;
        cout << "Car object created: " << brand << " (" << year << ")" << endl;
    }
    ~Car() {
        cout << "Car object destroyed: " << brand << endl;
    }
    void display() {
        cout << "Brand: " << brand << ", Year: " << year << endl;
    }
};
int main() {
    Car myCar("Toyota", 2023);
    myCar.display();
    return 0;
}
