#include <iostream>
#include <string>
using namespace std;
class Student {
    string name;
    int rollNo;
public:
    Student(string n, int r) {
        name = n;
        rollNo = r;
        cout << "Constructor called: Student object created." << endl;
    }
    void display() {
        cout << "Student Name: " << name << endl;
        cout << "Roll Number: " << rollNo << endl;
    }
    ~Student() {
        cout << "Destructor called: Student object destroyed." << endl;
    }
};
int main() {
    Student s1("NagaVenkata Siva", 5864789321);
    s1.display();
    return 0;
}
