#include <iostream>
using namespace std;
class SafeArray {
private:
    int arr[5];
public:
    SafeArray() {
        for (int i = 0; i < 5; i++) {
            arr[i] = (i + 1) * 10;
        }
    }
    // Overloading [] operator
    int& operator[](int index) {
        if (index < 0 || index >= 5) {
            cout << "Index out of bounds!" << endl;
            return arr[0]; // Returns first element as fallback
        }
        return arr[index];
    }
};
int main() {
    SafeArray sa;
    int idx;
    cout << "Enter array index to access (0-4): ";
    cin >> idx;
    cout << "\nOutput:\nValue at index " << idx << ": " << sa[idx] << endl;
    return 0;
}
